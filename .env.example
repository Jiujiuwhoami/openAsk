# === 应用基础配置 ===
APP_NAME=OpenAsk
ENVIRONMENT=production
DEBUG=false

# === LLM API 配置（兼容 OpenAI 格式） ===
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# === Zvec 向量数据库配置 ===
ZVEC_DATA_PATH=data/zvec
ZVEC_DIMENSION=384
ZVEC_CACHE_PATH=data/zvec_llm_cache
ZVEC_CACHE_DIMENSION=384

# === 嵌入服务配置 ===
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE_EMBEDDINGS=true

# === API 服务配置 ===
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=4
# ⚠️ 生产环境替换为实际前端域名
API_CORS_ORIGINS=http://localhost:5173

# === 限流配置 ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_USER=60/minute
RATE_LIMIT_GLOBAL_LIMIT=1000/minute
RATE_LIMIT_STRATEGY=sliding_window
# ℹ️ Docker Compose 中自动启用 Redis（redis://redis:6379/0）
# 本地开发可用 memory://，生产环境请使用 Redis
RATE_LIMIT_STORAGE_URI=memory://

# === LLM 缓存配置 ===
LLM_CACHE_ENABLED=true
LLM_CACHE_MAXSIZE=1000
LLM_CACHE_TTL=86400
LLM_CACHE_SIMILARITY_THRESHOLD=0.95
LLM_CACHE_STORAGE_URI=

# === 日志配置 ===
LOG_LEVEL=INFO
LOG_FILE=app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# === 监控配置 ===
METRICS_ENABLED=true
METRICS_PORT=8000

# === 多模态服务配置 ===
MULTIMODAL_ENABLED=false
MULTIMODAL_PROVIDER=generic
MULTIMODAL_API_KEY=
MULTIMODAL_API_BASE=https://api.openai.com/v1
MULTIMODAL_MODEL=gpt-4o
MULTIMODAL_TIMEOUT=30

# === 重排序器配置 ===
RERANKER_ENABLED=false
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_RECALL_TOP_K=20
RERANKER_RERANK_TOP_K=5

# === OAuth2 认证配置 ===
# ⚠️ 生产环境必须更换：openssl rand -hex 32
AUTH_SECRET_KEY=change-me-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === 邮件服务配置 ===
# 可选值：console（仅输出到日志）/ resend（通过 Resend.com 发送）
# 生产环境请使用 resend，注册地址：https://resend.com
EMAIL_PROVIDER=console
EMAIL_FROM_ADDR=noreply@openask.dev
EMAIL_RESEND_API_KEY=

# === Stripe 支付配置 ===
# 注册 Stripe 获取密钥：https://dashboard.stripe.com/apikeys
# 创建价格后把 ID 填入（格式如 price_xxx）
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=